@page
@model MBU_site.Pages.About.ManagementModel
@{
    ViewData["Title"] = "Руководство";
}

<div class="container">
    <h1 class="page-title">Руководство</h1>

    <p class="lead text-center mb-5">
        Руководящий состав МБУ «Южное»
    </p>

    <div class="row">
        <!-- Директор -->
        <div class="col-md-6 col-lg-4">
            <div class="card management-card">
                <div class="management-role role-director"></div>

                <img src="/person_logo.jpg"
                     class="management-photo"
                     alt="Швыдкий Виктор Юрьевич" />

                <div class="card-body text-center">
                    <h3 class="card-title">Швыдкий Виктор Юрьевич</h3>
                    <p class="card-text">
                        Директор МБУ «Южное»
                    </p>
                </div>
            </div>
        </div>

        <!-- Финансы -->
        <div class="col-md-6 col-lg-4">
            <div class="card management-card">
                <div class="management-role role-finance"></div>

                <img src="/person_logo.jpg"
                     class="management-photo"
                     alt="Стаценко Ренат Алексеевич" />

                <div class="card-body text-center">
                    <h3 class="card-title">Стаценко Ренат Алексеевич</h3>
                    <p class="card-text">
                        Заместитель директора по финансово-экономическим вопросам
                    </p>
                </div>
            </div>
        </div>

        <!-- Технический -->
        <div class="col-md-6 col-lg-4">
            <div class="card management-card">
                <div class="management-role role-tech"></div>

                <img src="/person_logo.jpg"
                     class="management-photo"
                     alt="Попов Виталий Анатольевич" />

                <div class="card-body text-center">
                    <h3 class="card-title">Попов Виталий Анатольевич</h3>
                    <p class="card-text">
                        Заместитель директора по техническим вопросам — главный инженер
                    </p>
                </div>
            </div>
        </div>

        <!-- Производство -->
        <div class="col-md-6 col-lg-4">
            <div class="card management-card">
                <div class="management-role role-production"></div>

                <img src="/person_logo.jpg"
                     class="management-photo"
                     alt="Акопян Григор Мкртичович" />

                <div class="card-body text-center">
                    <h3 class="card-title">Акопян Григор Мкртичович</h3>
                    <p class="card-text">
                        Заместитель директора по производству
                    </p>
                </div>
            </div>
        </div>

        <!-- Безопасность -->
        <div class="col-md-6 col-lg-4">
            <div class="card management-card">
                <div class="management-role role-safety"></div>

                <img src="/person_logo.jpg"
                     class="management-photo"
                     alt="Дорофеев Андрей Валерьевич" />

                <div class="card-body text-center">
                    <h3 class="card-title">Дорофеев Андрей Валерьевич</h3>
                    <p class="card-text">
                        Заместитель директора по содержанию искусственных сооружений и безопасности дорожного движения
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
