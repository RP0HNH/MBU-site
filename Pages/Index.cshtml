<!-- JavaScript -->
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const form = document.getElementById('glonassForm');
        const btn = document.getElementById('glonassBtn');
        const btnText = document.getElementById('btnText');

        if (form) {
            form.addEventListener('submit', function(e) {
                // Меняем текст кнопки на время загрузки
                btn.disabled = true;
                btn.innerHTML = '<span class="spinner"></span>Подключение...';

                // Разрешаем отправку формы
                return true;
            });
        }
    });
</script>