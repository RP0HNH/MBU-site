<!-- Добавляем минимальные дополнительные стили для кнопки ГЛОНАСС -->
<style>
    /* Дополнительные стили для карточки ГЛОНАСС */
    .glonass-card {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border: none !important;
        box-shadow: 0 20px 40px rgba(102, 126, 234, 0.3) !important;
        animation: fadeInUp 0.8s ease;
    }

    .glonass-card-content {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 20px;
    }

    .glonass-icon-wrapper {
        background: rgba(255, 255, 255, 0.2);
        width: 80px;
        height: 80px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        animation: pulse 2s infinite;
    }

    .glonass-text {
        flex: 1;
        min-width: 300px;
    }

    .btn-glonass {
        background: white !important;
        color: #764ba2 !important;
        border: none !important;
        padding: 15px 35px !important;
        border-radius: 50px !important;
        font-weight: 600 !important;
        box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1) !important;
    }

        .btn-glonass:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 30px rgba(0, 0, 0, 0.2) !important;
            background: #f8f9fa !important;
        }

        .btn-glonass:disabled {
            opacity: 0.7;
            cursor: not-allowed;
            transform: none;
        }

    .spinner {
        display: inline-block;
        width: 20px;
        height: 20px;
        border: 3px solid rgba(118, 75, 162, 0.3);
        border-radius: 50%;
        border-top-color: #764ba2;
        animation: spin 1s ease-in-out infinite;
        margin-right: 10px;
        vertical-align: middle;
    }

    /* Исправлено: keyframes без отступа */
    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }

    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes pulse {
        0% {
